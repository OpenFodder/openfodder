+int
+Platform::GetConfigInt(const char *name)
+{
+   const char *value = getenv(name);
+   return value ? atoi(value) : 0;
+}
+
+bool
+Platform::GetConfigBool(const char *name)
+{
+   const char *value = getenv(name);
+   if (!value) {
+      return false;
+   }
+   return atoi(value) != 0 || strcasecmp(value, "true") == 0;
+}
