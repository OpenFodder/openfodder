+inline int
+sprintf_s(char *buffer, size_t size, const char *fmt, ...)
+{
+   va_list args;
+   va_start(args, fmt);
+   int result = vsnprintf(buffer, size, fmt, args);
+   va_end(args);
+   if (size > 0) {
+      buffer[size - 1] = '\0';
+   }
+   return result;
+}
+
+inline int
+vsprintf_s(char *buffer, size_t size, const char *fmt, va_list args)
+{
+   int result = vsnprintf(buffer, size, fmt, args);
+   if (size > 0) {
+      buffer[size - 1] = '\0';
+   }
+   return result;
+}
+
+inline int
+strcpy_s(char *dest, size_t destsz, const char *src)
+{
+   if (!dest || !src || destsz == 0) {
+      return EINVAL;
+   }
+   strncpy(dest, src, destsz - 1);
+   dest[destsz - 1] = '\0';
+   return 0;
+}
+
+template <size_t N>
+inline int
+strcpy_s(char (&dest)[N], const char *src)
+{
+   return strcpy_s(dest, N, src);
+}
+
+inline int
+strncat_s(char *dest, size_t destsz, const char *src, size_t count)
+{
+   if (!dest || !src || destsz == 0) {
+      return EINVAL;
+   }
+   size_t used = strlen(dest);
+   size_t available = destsz > used ? destsz - used : destsz;
+   if (available == 0) {
+      return ERANGE;
+   }
+   size_t copy = strnlen(src, count);
+   if (copy >= available) {
+      copy = available - 1;
+   }
+   memcpy(dest + used, src, copy);
+   dest[used + copy] = '\0';
+   return 0;
+}
+
+inline int
+fopen_s(FILE **fp, const char *filename, const char *mode)
+{
+   *fp = fopen(filename, mode);
+   return *fp ? 0 : errno;
+}
