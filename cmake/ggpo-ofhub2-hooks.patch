diff --git a/src/lib/ggpo/network/udp.h b/src/lib/ggpo/network/udp.h
index be9d975..ea75757 100644
--- a/src/lib/ggpo/network/udp.h
+++ b/src/lib/ggpo/network/udp.h
@@ -13,6 +13,38 @@
 #include "ggponet.h"
 #include "ring_buffer.h"
 
+// OFHUB/2 binary data-plane wrap/unwrap hooks (see openfodder-hub
+// docs/OFHUB2.md §6 and openfodder Source/Network/HubFrame.{cpp,hpp}).
+// When installed via Udp::InstallOfhubHooks(), every outbound packet is
+// passed through `wrap` before ::sendto and every inbound datagram is
+// passed through `unwrap` before being delivered to the GGPO callbacks.
+// Both functions take an opaque ctx, an input buffer + length, and a
+// caller-owned output buffer + capacity. `wrap` returns the framed
+// length on success or 0 to drop the packet. `unwrap` returns the
+// verified payload length on success or 0 to drop the datagram (replay,
+// bad MAC, malformed header). When the hooks are not installed
+// (default), Udp falls through to plain UDP behaviour.
+//
+// `unwrap` additionally receives a mutable pointer to the recvfrom()
+// sockaddr. Under OFHUB/2 fan-out every datagram arrives from the
+// shared hub address, which would collapse GGPO's per-endpoint demux
+// (Peer2PeerBackend::OnMsg picks the first endpoint whose HandlesMsg
+// matches the source addr -- see HandlesMsg in udp_proto.cpp). The
+// unwrap callback rewrites recv_addr to a deterministic synthetic
+// address per verified peer index, so GGPO's "address == endpoint"
+// invariant holds. Pass-through (no hook installed) leaves recv_addr
+// alone.
+//
+// `wrap` is the symmetric counterpart: GGPO caches the synthetic
+// address as each UdpProtocol's _peer_addr (because that's what the
+// app handed to ggpo_add_player), so without intervention sendto()
+// would deliver to 127.0.0.<i+1> instead of the hub. The wrap callback
+// receives a mutable pointer to the sendto() destination sockaddr and
+// rewrites it to the real hub address before the syscall fires. Pass-
+// through (no hook installed) leaves dst alone.
+typedef int (*OfhubWrapFn)(void* ctx, const char* in, int inLen, char* outBuffer, int capacity, struct sockaddr_in* dst_inout);
+typedef int (*OfhubUnwrapFn)(void* ctx, const char* in, int inLen, char* outBuffer, int capacity, struct sockaddr_in* recv_addr_inout);
+
 #define MAX_UDP_ENDPOINTS     16
 
 static const int MAX_UDP_PACKET_SIZE = 4096;
@@ -44,6 +76,9 @@ public:
 
    virtual bool OnLoopPoll(void *cookie);
 
+   // Install OFHUB/2 wrap/unwrap hooks. Pass NULL for both to disable.
+   void InstallOfhubHooks(OfhubWrapFn wrap, OfhubUnwrapFn unwrap, void *ctx);
+
 public:
    ~Udp(void);
 
@@ -54,6 +89,11 @@ protected:
    // state management
    Callbacks      *_callbacks;
    Poll           *_poll;
+
+   // OFHUB/2 wrap/unwrap hooks (NULL when not installed -> pass-through).
+   OfhubWrapFn    _ofhub_wrap;
+   OfhubUnwrapFn  _ofhub_unwrap;
+   void          *_ofhub_ctx;
 };
 
 #endif
