+GGPOErrorCode
+ggpo_p2p_install_ofhub_hooks(GGPOSession *ggpo,
+                             int (*wrap)(void *ctx, const char *in, int inLen, char *outBuffer, int capacity, struct sockaddr_in *dst_inout),
+                             int (*unwrap)(void *ctx, const char *in, int inLen, char *outBuffer, int capacity, struct sockaddr_in *recv_addr_inout),
+                             void *ctx)
+{
+   if (!ggpo) {
+      return GGPO_ERRORCODE_INVALID_SESSION;
+   }
+   Peer2PeerBackend *p2p = dynamic_cast<Peer2PeerBackend *>(ggpo);
+   if (!p2p) {
+      return GGPO_ERRORCODE_INVALID_REQUEST;
+   }
+   p2p->GetUdp().InstallOfhubHooks((OfhubWrapFn)wrap, (OfhubUnwrapFn)unwrap, ctx);
+   return GGPO_OK;
+}
