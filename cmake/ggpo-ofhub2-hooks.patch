+/*
+ * ggpo_p2p_install_ofhub_hooks --
+ *
+ * Install OFHUB/2 wrap/unwrap callbacks on the session's UDP socket.
+ * Every outbound packet is run through `wrap` before sendto(); every
+ * inbound datagram is run through `unwrap` before being delivered to
+ * the GGPO callbacks. Pass NULL for both wrap and unwrap to disable.
+ *
+ * The function-pointer types here are intentionally written out
+ * inline (rather than referencing OfhubWrapFn/OfhubUnwrapFn from the
+ * internal udp.h) so this public header has no dependency on the
+ * internal tree. They are structurally identical and assignment-
+ * compatible across the boundary.
+ *
+ * `unwrap` receives a mutable pointer to the recvfrom() sockaddr so
+ * the OFHUB/2 layer can rewrite source addresses to a per-peer
+ * synthetic value, preserving GGPO's "address == endpoint identity"
+ * invariant under hub fan-out (every datagram arrives from the shared
+ * hub address otherwise). `wrap` symmetrically receives a mutable
+ * pointer to the sendto() destination sockaddr so the OFHUB/2 layer
+ * can rewrite the per-peer synthetic destination back to the real hub
+ * address before the syscall (otherwise sendto() would deliver to
+ * 127.0.0.<i+1> instead of the hub). `struct sockaddr_in` is forward-
+ * declared so this public header still has no winsock/posix-sockets
+ * dependency; callers include the appropriate sockets header before
+ * defining the callback body.
+ *
+ * Returns GGPO_OK on success. Returns GGPO_ERRORCODE_INVALID_SESSION
+ * when `session` is NULL, or GGPO_ERRORCODE_INVALID_REQUEST when the
+ * session is not a peer-to-peer session (sync-test and spectator
+ * sessions either have no Udp instance or no remote peer to frame
+ * traffic to).
+ */
+struct sockaddr_in;
+GGPO_API GGPOErrorCode __cdecl ggpo_p2p_install_ofhub_hooks(
+        GGPOSession *session,
+        int (*wrap)(void *ctx, const char *in, int inLen, char *outBuffer, int capacity, struct sockaddr_in *dst_inout),
+        int (*unwrap)(void *ctx, const char *in, int inLen, char *outBuffer, int capacity, struct sockaddr_in *recv_addr_inout),
+        void *ctx);
+
